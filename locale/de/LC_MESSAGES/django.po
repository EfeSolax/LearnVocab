msgid "en temel kelimeler"
msgstr "die grundlegendsten Wörter"

#: LearnVocab/anasayfa.py:42
msgid "günlük hayat"
msgstr "Alltag"

#: LearnVocab/anasayfa.py:42
msgid "hazırlığın ilk dönemi"
msgstr "das erste Semester im Vorbereitungsjahr"

#: LearnVocab/anasayfa.py:43
msgid "okuma metinleri, sınavlar"
msgstr "Lesetexte, Prüfungen"

#: LearnVocab/anasayfa.py:43
msgid "akademik metinler"
msgstr "akademische Texte"

#: LearnVocab/anasayfa.py:43
msgid "ince ayrıntılar"
msgstr "feine Nuancen"

#: LearnVocab/authgate.py:39
msgid "Kelimeleri listene ekleyebilmek için bir hesaba ihtiyacın var."
msgstr "Du brauchst ein Konto, um Wörter zu deiner Liste hinzuzufügen."

#: LearnVocab/authgate.py:40 egzersizler/views.py:41
msgid "Egzersizler kendi listenle çalıştığı için giriş yapman gerekiyor."
msgstr ""
"Übungen arbeiten mit deiner eigenen Liste, deshalb musst du dich anmelden."

#: LearnVocab/authgate.py:41 texts/views.py:41
msgid "Yazdıkların hesabına kaydedildiği için giriş yapman gerekiyor."
msgstr ""
"Was du schreibst, wird in deinem Konto gespeichert, deshalb musst du dich "
"anmelden."

#: LearnVocab/authgate.py:42 readings/views.py:192
msgid "Kendi metinlerini yükleyebilmek için giriş yapman gerekiyor."
msgstr "Du musst dich anmelden, um eigene Texte hochzuladen."

#: LearnVocab/authgate.py:43
msgid "Çalışmanın kaydedilmesi için giriş yapman gerekiyor."
msgstr "Du musst dich anmelden, damit dein Lernfortschritt gespeichert wird."

#: LearnVocab/authgate.py:76 LearnVocab/authgate.py:78
msgid "Önce giriş yapmalısın."
msgstr "Bitte melde dich zuerst an."

#: LearnVocab/diller.py:145
