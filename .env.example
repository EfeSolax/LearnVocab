# =====================================================================
# LearnVocab - Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp değerleri kendi ortamına göre doldur:
#   cp .env.example .env
# .env dosyasını ASLA git'e commit etme.
# =====================================================================

# Django
SECRET_KEY=buraya-50-karakterli-rastgele-bir-anahtar-uret
DEBUG=True

# E-posta (Gmail App Password)
EMAIL_HOST_USER=ornek@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# Gemini API
GEMINI_API_TOKEN=AIzaSy...
# Kullanılacak model. Anahtarınızın erişebildiklerini görmek için:
#   python manage.py list_gemini_models
GEMINI_MODEL=gemini-2.5-flash
# Asıl model geçici olarak cevap veremezse (503) sırayla denenecek yedekler
GEMINI_FALLBACK_MODELS=
# Tek bir isteğin zaman aşımı ve geçici hatalarda tekrar deneme sayısı
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
# İki istek arasındaki asgari boşluk. Ücretsiz katman model başına dakikada
# 5 istek veriyor; 13 sn bu sınırın altında kalmayı sağlıyor. Ücretli planda 0.
GEMINI_MIN_SECONDS_BETWEEN_REQUESTS=13

# Kullanıcı ne sıklıkla yeni metin yazabilsin (dakika)
#   1440 -> günde bir | 5 -> beş dakikada bir | 0 -> kısıt kapalı
TEXT_SUBMISSION_INTERVAL_MINUTES=1440

# Yapay zeka ile kelime ekleme
AI_WORD_IMPORT_MAX_WORDS=20
AI_WORD_IMPORT_CHUNK_SIZE=10
AI_WORD_IMPORT_TIME_BUDGET_SECONDS=150
AI_WORD_IMPORT_TIMEOUT_SECONDS=60

# Veritabanı
# Lokalde SQLite kullanmak için DB_ENGINE'i boş bırak (default: sqlite3).
DB_ENGINE=django.db.backends.mysql
DB_NAME=learnvoc_learnvocab
DB_USER=learnvoc_learnvocab_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=
