{
  "manifest_version": 3,
  "name": "__MSG_ad__",
  "short_name": "LearnVocab",
  "description": "__MSG_aciklama__",
  "version": "1.0.0",
  "default_locale": "tr",
  "homepage_url": "https://www.learnvocab.com.tr/",
  "icons": {
    "16": "simgeler/16.png",
    "32": "simgeler/32.png",
    "48": "simgeler/48.png",
    "128": "simgeler/128.png"
  },
  "action": {
    "default_title": "__MSG_simge_basligi__",
    "default_popup": "pencere.html",
    "default_icon": {
      "16": "simgeler/16.png",
      "32": "simgeler/32.png"
    }
  },
  "background": {
    "service_worker": "arkaplan.js"
  },
  "host_permissions": [
    "https://www.learnvocab.com.tr/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["icerik.js"],
      "run_at": "document_idle"
    }
  ]
}
